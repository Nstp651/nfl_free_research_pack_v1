{
  "openapi": "3.1.0",
  "info": {
    "title": "Nick NFL Receptions V5 Bet Tracker",
    "version": "1.0.2-builder.1",
    "description": "GPT Builder-safe tracker contract for NFL Receptions V5. Stores only the compact actionable post-freeze board (max 25 selections) and records only user-confirmed placed wagers."
  },
  "servers": [
    {"url": "https://nick-betting-api.nickarnott01.workers.dev"}
  ],
  "security": [
    {"apiKeyAuth": []}
  ],
  "paths": {
    "/tracker/health": {
      "get": {
        "operationId": "checkBetTracker",
        "x-openai-isConsequential": false,
        "summary": "Check production bet tracker health",
        "responses": {
          "200": {"description": "Tracker health", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TrackerHealth"}}}},
          "401": {"description": "Unauthorized", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/tracker/model-runs": {
      "post": {
        "operationId": "createNflReceptionsTrackerRun",
        "x-openai-isConsequential": false,
        "summary": "Record a completed frozen NFL Receptions V5 run",
        "description": "Call once after Layer 3/4. Send only deterministic actionable ranked selections, maximum 25. Never send the entire frozen ladder. Tracker writes cannot change the V5 freeze.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateModelRunRequest"}}}},
        "responses": {
          "200": {"description": "Existing idempotent model run", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateModelRunResponse"}}}},
          "201": {"description": "New model run recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateModelRunResponse"}}}},
          "400": {"description": "Invalid payload", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "401": {"description": "Unauthorized", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "409": {"description": "request_id conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/tracker/bets": {
      "post": {
        "operationId": "recordNflReceptionsBet",
        "x-openai-isConsequential": false,
        "summary": "Record a user-confirmed NFL Receptions wager",
        "description": "Call only after the user explicitly confirms the wager was placed. The leg must reference a model_selection_id returned by createNflReceptionsTrackerRun.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecordBetRequest"}}}},
        "responses": {
          "200": {"description": "Existing idempotent bet", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecordBetResponse"}}}},
          "201": {"description": "Bet recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecordBetResponse"}}}},
          "400": {"description": "Invalid bet payload", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "401": {"description": "Unauthorized", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "404": {"description": "Model selection not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "409": {"description": "request_id conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      },
      "get": {
        "operationId": "listNflReceptionsTrackedBets",
        "x-openai-isConsequential": false,
        "summary": "List tracked bets",
        "parameters": [
          {"name": "status", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "bookmaker", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "bet_type", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}}
        ],
        "responses": {
          "200": {
            "description": "Tracked bets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {"type": "integer"},
                    "bets": {"type": "array", "items": {"$ref": "#/components/schemas/TrackedBetSummary"}}
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {"type": "apiKey", "in": "header", "name": "X-GPT-Action-Key"}
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "message": {"anyOf": [{"type": "string"}, {"type": "null"}]}
        },
        "additionalProperties": true
      },
      "TrackerHealth": {
        "type": "object",
        "properties": {
          "service": {"type": "string"},
          "status": {"type": "string"},
          "api_version": {"type": "string"},
          "schema_version": {"type": "string"},
          "database_binding": {"type": "string"},
          "current_unit_size": {"type": "number"}
        },
        "additionalProperties": true
      },
      "ModelSelectionInput": {
        "type": "object",
        "required": ["selection_name", "market_family", "p_model"],
        "properties": {
          "selection_name": {"type": "string"},
          "player_name": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "team_name": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "market_family": {"type": "string", "enum": ["nfl_receptions"]},
          "market_key": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "side": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "threshold": {"anyOf": [{"type": "number"}, {"type": "null"}]},
          "p_model": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "fair_odds": {"anyOf": [{"type": "number"}, {"type": "null"}]},
          "confidence": {"anyOf": [{"type": "number"}, {"type": "null"}], "description": "Legacy numeric tracker field. Leave null for NFL V5 and preserve categorical Confidence/Fragility in notes/key_assumptions."},
          "market_price_at_integration": {"anyOf": [{"type": "number"}, {"type": "null"}]},
          "market_bookmaker_at_integration": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "p_market_at_integration": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
          "edge_at_integration": {"anyOf": [{"type": "number"}, {"type": "null"}]},
          "ranking_score": {"anyOf": [{"type": "number"}, {"type": "null"}]},
          "final_rank": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
          "final_play": {"type": "boolean"},
          "key_assumptions": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "notes": {"anyOf": [{"type": "string"}, {"type": "null"}]}
        },
        "additionalProperties": false
      },
      "CreateModelRunRequest": {
        "type": "object",
        "required": ["sport", "league", "model_name", "fixture", "selections"],
        "properties": {
          "request_id": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$"}, {"type": "null"}]},
          "sport": {"type": "string", "enum": ["nfl"]},
          "league": {"type": "string", "enum": ["nfl"]},
          "model_name": {"type": "string", "enum": ["NFL Receptions V5"]},
          "model_version": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "season": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "round_week": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "fixture_date": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "event_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "home_team": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "away_team": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "fixture": {"type": "string"},
          "timing_mode": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "frozen_at": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "research_state": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "notes": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "selections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "description": "Compact handoff only: deterministic positive-edge ranked selections in rank order, including BEST SINGLE when present. Never send the full frozen ladder.",
            "items": {"$ref": "#/components/schemas/ModelSelectionInput"}
          }
        },
        "additionalProperties": false
      },
      "ModelSelectionStored": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "selection_name": {"type": "string"},
          "player_name": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "market_family": {"type": "string"},
          "market_key": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "threshold": {"anyOf": [{"type": "number"}, {"type": "null"}]},
          "p_model": {"type": "number"},
          "final_rank": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
          "final_play": {"anyOf": [{"type": "integer"}, {"type": "boolean"}, {"type": "null"}]}
        },
        "additionalProperties": true
      },
      "CreateModelRunResponse": {
        "type": "object",
        "properties": {
          "status": {"type": "string"},
          "idempotent": {"type": "boolean"},
          "request_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "model_run_id": {"type": "string"},
          "selection_count": {"type": "integer"},
          "selections": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/ModelSelectionStored"}}
        },
        "additionalProperties": true
      },
      "RecordBetLeg": {
        "type": "object",
        "required": ["model_selection_id"],
        "properties": {
          "model_selection_id": {"type": "string"},
          "execution_leg_odds": {"anyOf": [{"type": "number"}, {"type": "null"}]}
        },
        "additionalProperties": false
      },
      "RecordBetRequest": {
        "type": "object",
        "required": ["bookmaker", "bet_type", "stake", "accepted_odds", "legs"],
        "properties": {
          "request_id": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$"}, {"type": "null"}]},
          "bookmaker": {"type": "string"},
          "bet_type": {"type": "string", "enum": ["single"]},
          "stake": {"type": "number", "exclusiveMinimum": 0},
          "accepted_odds": {"type": "number", "exclusiveMinimum": 1},
          "unboosted_odds": {"anyOf": [{"type": "number"}, {"type": "null"}]},
          "promo_label": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "bookmaker_bet_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "placed_at": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "notes": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "legs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/components/schemas/RecordBetLeg"}}
        },
        "additionalProperties": false
      },
      "RecordedBetLeg": {
        "type": "object",
        "properties": {
          "id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "leg_number": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
          "model_selection_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "model_run_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "selection_name": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "fixture": {"anyOf": [{"type": "string"}, {"type": "null"}]}
        },
        "additionalProperties": true
      },
      "RecordBetResponse": {
        "type": "object",
        "properties": {
          "status": {"type": "string"},
          "idempotent": {"type": "boolean"},
          "request_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "bet_ticket_id": {"type": "string"},
          "bookmaker": {"type": "string"},
          "bet_type": {"type": "string"},
          "stake": {"type": "number"},
          "accepted_odds": {"type": "number"},
          "unit_size": {"type": "number"},
          "units_staked": {"type": "number"},
          "legs": {"type": "array", "items": {"$ref": "#/components/schemas/RecordedBetLeg"}}
        },
        "additionalProperties": true
      },
      "TrackedBetSummary": {
        "type": "object",
        "properties": {
          "id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "status": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "bookmaker": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "bet_type": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "stake": {"anyOf": [{"type": "number"}, {"type": "null"}]},
          "accepted_odds": {"anyOf": [{"type": "number"}, {"type": "null"}]}
        },
        "additionalProperties": true
      }
    }
  }
}
