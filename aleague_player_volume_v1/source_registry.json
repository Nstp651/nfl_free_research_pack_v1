{
  "schema_version": "1.1.0",
  "model": "ALEAGUE_PLAYER_VOLUME_V1",
  "sources": [
    {
      "id": "api_football",
      "class": "AUTO_APPROVED",
      "purpose": [
        "fixtures",
        "lineups",
        "historical_player_match_shooting",
        "historical_team_match_shooting",
        "goalkeeper_match_saves",
        "player_identity",
        "team_identity",
        "transfers",
        "injuries_where_covered"
      ],
      "runtime_dependency": false,
      "credential": "API_FOOTBALL_KEY",
      "notes": "Primary V1 structured feed candidate. A-League Men is API-Football league 188. Canonical assets are published into the repo/pack so runtime never depends on the API being reachable. Coverage flags and null-rate gates are mandatory."
    },
    {
      "id": "skillcorner_opendata",
      "class": "AUTO_APPROVED_OPEN_DATA",
      "purpose": [
        "tracking_calibration",
        "off_ball_run_research",
        "physical_role_features",
        "passing_role_features",
        "phase_of_play_research"
      ],
      "runtime_dependency": false,
      "license": "MIT",
      "notes": "Open A-League 2024/25 sample contains 10 tracking matches plus season-level Physical/OBR/Passing aggregates. Valuable for feature engineering and role priors but not sufficient as the core historical event feed."
    },
    {
      "id": "official_aleague_clubs",
      "class": "AUTO_OR_RESEARCH_BY_ROUTE",
      "purpose": ["fixtures_reconciliation", "squads", "injuries", "suspensions", "current_role", "coach_system", "transfers"],
      "runtime_dependency": false,
      "notes": "Prefer official evidence for current availability and role. Automate only stable approved routes."
    },
    {
      "id": "fbref_aleague",
      "class": "RESEARCH_RECONCILIATION_ONLY",
      "purpose": ["manual_reconciliation", "historical_context", "spot_checks"],
      "runtime_dependency": false,
      "notes": "Do not schedule automated extraction or build the predictive database from FBref. Sports Reference data-use restrictions and 2026 provider changes make it unsuitable as V1 machine ingestion."
    },
    {
      "id": "fotmob",
      "class": "RESEARCH_ONLY",
      "purpose": ["xg_xa_context", "shot_map_context", "box_touches", "chance_creation", "recent_role"],
      "runtime_dependency": false,
      "notes": "No unattended scraper in V1."
    },
    {
      "id": "transfermarkt",
      "class": "RESEARCH_ONLY",
      "purpose": ["transfer_history_reconciliation", "prior_club", "prior_competition_context"],
      "runtime_dependency": false,
      "notes": "Research enrichment until a separately approved ingestion route exists."
    },
    {
      "id": "licensed_advanced_feed",
      "class": "LICENSED_OPTION",
      "purpose": ["event_data", "shot_quality", "post_shot_xg", "pressure", "possession_value", "full_tracking"],
      "runtime_dependency": false,
      "notes": "Optional future upgrade only with explicit approval; no V1 production dependency."
    }
  ]
