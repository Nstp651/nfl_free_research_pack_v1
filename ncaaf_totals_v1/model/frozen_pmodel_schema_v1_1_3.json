{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ncaaf/frozen-pmodel-v1.1.3.json",
  "title": "Nick NCAA Totals Frozen P_model V1.1.3",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "p_model_status",
    "frozen_at",
    "probability_schema_version",
    "identity_receipt_sha256",
    "games",
    "lock",
    "market_data",
    "numerical_output_sha256",
    "input_sha256",
    "freeze_receipt_sha256",
    "qbase_model_sha256",
    "identity_binding_audit",
    "probability_audit",
    "zero_shift_audit"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.3"
    },
    "p_model_status": {
      "const": "FROZEN"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "probability_schema_version": {
      "const": "0.2.0"
    },
    "identity_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "game_id",
          "home_team",
          "away_team",
          "commence_time",
          "expected_total_qbase",
          "contextual_shift",
          "expected_total_final",
          "distribution_changed",
          "qbase_anchor_sha256",
          "qbase_probability_grid_sha256",
          "frozen_probability_grid_sha256",
          "confidence",
          "fragility",
          "probability_grid",
          "context",
          "fixture"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "minLength": 1
          },
          "home_team": {
            "type": "string",
            "minLength": 1
          },
          "away_team": {
            "type": "string",
            "minLength": 1
          },
          "commence_time": {
            "type": "string",
            "format": "date-time"
          },
          "expected_total_qbase": {
            "type": "number"
          },
          "contextual_shift": {
            "type": "number"
          },
          "expected_total_final": {
            "type": "number"
          },
          "distribution_changed": {
            "type": "boolean"
          },
          "qbase_anchor_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "qbase_probability_grid_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frozen_probability_grid_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "confidence": {
            "type": "string",
            "minLength": 1
          },
          "fragility": {
            "type": "string",
            "minLength": 1
          },
          "frozen_thesis": {
            "type": "string"
          },
          "probability_grid": {
            "type": "array",
            "minItems": 162,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line",
                "over",
                "push",
                "under"
              ],
              "properties": {
                "line": {
                  "type": "number"
                },
                "over": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "push": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "under": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "maxItems": 162
          }
        }
      }
    },
    "lock": {
      "type": "object",
      "required": [
        "season",
        "week",
        "slate_id",
        "pack_revision",
        "qbase_revision",
        "eligible_game_ids"
      ],
      "properties": {
        "eligible_game_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "market_data": {
      "const": false
    },
    "numerical_output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "freeze_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "qbase_model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity_binding_audit": {
      "const": "PASS"
    },
    "probability_audit": {
      "const": "PASS"
    },
    "zero_shift_audit": {
      "const": "PASS"
    }
  }
}
