{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kj.local/schemas/ibkr-market-input-v1.json",
  "title": "IBKR Screenshot Market Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_type", "run_id", "ticker", "freeze_receipt_sha256", "screenshot_sha256", "captured_at", "underlying_price", "quotes"],
  "properties": {
    "source_type": { "const": "IBKR_SCREENSHOT" },
    "run_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ticker": { "type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$" },
    "freeze_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "screenshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "underlying_price": { "type": "number", "exclusiveMinimum": 0 },
    "extraction_notes": { "type": ["string", "null"] },
    "quotes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expiry", "strike", "right", "bid", "ask"],
        "properties": {
          "expiry": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "strike": { "type": "number", "exclusiveMinimum": 0 },
          "right": { "enum": ["CALL", "PUT"] },
          "bid": { "type": "number", "minimum": 0 },
          "ask": { "type": "number", "exclusiveMinimum": 0 },
          "iv": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "delta": { "type": ["number", "null"] },
          "open_interest": { "type": ["integer", "null"], "minimum": 0 },
          "volume": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
