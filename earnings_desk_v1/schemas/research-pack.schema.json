{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kj.local/schemas/earnings-research-pack-v1.json",
  "title": "Market-Blind Earnings Research Pack V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["market_data", "ticker", "event_id", "evidence_quality", "evidence", "features", "feature_evidence", "conflicts"],
  "properties": {
    "market_data": { "const": false },
    "ticker": { "type": "string" },
    "event_id": { "type": "string" },
    "evidence_quality": { "enum": ["HIGH", "MEDIUM", "LOW"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "source_type", "url", "title", "fact", "retrieved_at"],
        "properties": {
          "evidence_id": { "type": "string" },
          "source_type": { "enum": ["SEC_OR_OFFICIAL_FILING", "COMPANY_INVESTOR_RELATIONS", "COMPANY_GUIDANCE", "CONSENSUS_AND_REVISIONS", "PEER_READTHROUGH", "INDUSTRY_OR_MACRO", "HISTORICAL_EARNINGS", "MARKET_OR_SECTOR_REGIME", "MATERIAL_COMPANY_NEWS"] },
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "fact": { "type": "string" },
          "published_at": { "type": ["string", "null"], "format": "date-time" },
          "retrieved_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eps_revision_z", "revenue_revision_z", "guidance_trajectory", "consensus_dispersion_z", "peer_readthrough_z", "pre_earnings_drift_z", "sector_regime_z", "index_regime_z", "company_specific_z", "surprise_reaction_beta_z"],
      "properties": {
        "eps_revision_z": { "$ref": "#/$defs/feature" },
        "revenue_revision_z": { "$ref": "#/$defs/feature" },
        "guidance_trajectory": { "$ref": "#/$defs/feature" },
        "consensus_dispersion_z": { "$ref": "#/$defs/feature" },
        "peer_readthrough_z": { "$ref": "#/$defs/feature" },
        "pre_earnings_drift_z": { "$ref": "#/$defs/feature" },
        "sector_regime_z": { "$ref": "#/$defs/feature" },
        "index_regime_z": { "$ref": "#/$defs/feature" },
        "company_specific_z": { "$ref": "#/$defs/feature" },
        "surprise_reaction_beta_z": { "$ref": "#/$defs/feature" }
      }
    },
    "feature_evidence": { "type": "object" },
    "conflicts": { "type": "array" }
  },
  "$defs": {
    "feature": { "type": "number", "minimum": -3, "maximum": 3 }
  }
}
